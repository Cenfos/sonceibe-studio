# Private Studio access. Do not commit real codes.
# Keep the first user named "owner" to migrate your existing browser projects.
# Add more users separated by semicolons.
STUDIO_ACCESS_CODES=owner=CHANGE-ME;guest1=CHANGE-ME-TOO

# Private Vercel Blob store (server only). Injected by the connected store.
BLOB_READ_WRITE_TOKEN=
# HTTPS URL loaded by the Windows application at build time.
STUDIO_DESKTOP_URL=https://sonceibe-studio.vercel.app
