# Supabase Auth (server only). Use the publishable/anon key, never service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Private Vercel Blob store (server only). Injected by the connected store.
BLOB_READ_WRITE_TOKEN=
# HTTPS URL loaded by the Windows application at build time.
STUDIO_DESKTOP_URL=https://sonceibe-studio.vercel.app
