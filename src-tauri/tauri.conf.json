{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SonCeibe Studio",
  "version": "0.1.0",
  "identifier": "es.sonceibe.studio",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://studio.invalid"
  },
  "app": {
    "windows": [
      {
        "title": "SonCeibe Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ]
      }
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
